{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyx.local/schemas/evidence.schema.json",
  "title": "EvidenceItem",
  "description": "An evidence record or reference. Hand-written from docs/SPEC.md 5.4. Phase 1 MUST add a test proving the Pydantic models and this schema agree; until that test passes, this file is a Phase 0 contract, not a verified artifact. An integrity method such as hash or signed establishes integrity or authenticity under stated assumptions, never the truth of the statement. Both inline and reference-only evidence are supported; large or restricted payloads must not be copied into findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "kind",
    "title",
    "description",
    "source_ref",
    "captured_at",
    "valid_from",
    "integrity_method",
    "limitations",
    "sensitivity",
    "access_policy_ref",
    "retention_class"
  ],
  "anyOf": [
    { "required": ["source_system_id"] },
    { "required": ["source_name"] }
  ],
  "allOf": [
    {
      "anyOf": [
        { "required": ["relevance_to_claim"] },
        { "required": ["relevance_to_finding"] }
      ]
    }
  ],
  "properties": {
    "id": { "$ref": "#/$defs/identifier" },
    "schema_version": { "$ref": "#/$defs/schema_version" },
    "kind": {
      "type": "string",
      "enum": [
        "ci_test_result",
        "test_result",
        "log",
        "trace",
        "source_file",
        "commit",
        "artifact_digest",
        "attestation",
        "measurement",
        "policy_evaluation",
        "review_record",
        "deployment_record",
        "runtime_observation",
        "model_assessment",
        "external_reference",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source_system_id": { "$ref": "#/$defs/identifier" },
    "source_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scope": { "$ref": "#/$defs/scope" },
    "captured_at": { "$ref": "#/$defs/timestamp" },
    "valid_from": { "$ref": "#/$defs/timestamp" },
    "valid_until": { "$ref": "#/$defs/timestamp" },
    "content_hash": { "$ref": "#/$defs/digest" },
    "integrity_method": {
      "type": "string",
      "enum": ["none", "hash", "signed", "attested", "external"]
    },
    "producer_identity": { "$ref": "#/$defs/principal_ref" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["not_checked", "verified", "failed", "inconclusive"]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "verified_at": { "$ref": "#/$defs/timestamp" },
        "verified_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "relevance_to_claim": { "$ref": "#/$defs/identifier" },
    "relevance_to_finding": { "$ref": "#/$defs/identifier" },
    "relevance_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "access_policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "retention_class": { "$ref": "#/$defs/retention_class" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "retention_class": {
      "type": "string",
      "enum": ["ephemeral", "standard", "extended", "legal_hold", "derived_metadata"]
    },
    "scope": {
      "type": "object",
      "description": "Optional explicit scope for evidence that is only valid for a particular artifact, commit, environment, or period.",
      "additionalProperties": false,
      "required": ["system_id"],
      "properties": {
        "system_id": { "$ref": "#/$defs/identifier" },
        "artifact": { "type": "string", "minLength": 1, "maxLength": 512 },
        "commit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 64 },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from"],
          "properties": {
            "from": { "$ref": "#/$defs/timestamp" },
            "to": { "$ref": "#/$defs/timestamp" }
          }
        },
        "conditions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": [
            "system",
            "principal",
            "agent",
            "tool",
            "human",
            "service",
            "artifact",
            "unknown"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
