# NYX configuration example. Copy to .env for local use.
# Safe defaults: loopback bind, local SQLite, redaction on, no authentication.

NYX_HOST=127.0.0.1
NYX_PORT=8000
NYX_DATABASE_URL=sqlite:///./data/nyx.sqlite3
NYX_DATA_DIR=./data

NYX_MAX_PAYLOAD_BYTES=1048576
NYX_MAX_BATCH_SIZE=100

# Comma-separated or JSON list in the environment; leave empty until Phase 2.
NYX_ENABLED_CRITICS=[]
NYX_ENABLED_ADAPTERS=[]

NYX_LOG_LEVEL=INFO
NYX_REDACTION_ENABLED=true

# auth_mode: none | local | api_key
# A non-loopback host requires auth_mode other than "none".
# Loopback + "none" is the trusted local-operator boundary: requests are granted the deployment
# owner's capabilities, which is why every existing local caller and probe needs no credential.
NYX_AUTH_MODE=none
# Single-operator key. Either this or NYX_AUTH_PRINCIPALS satisfies auth_mode='api_key'.
# NYX_AUTH_API_KEY=change-me
# Named principals, for a deployment with more than one. JSON list; the raw key is read from the
# named environment variable, so no secret lives in this file.
# [{"principal_id": "ops", "api_key_env": "NYX_AUTH_KEY_OPS",
#   "capabilities": ["findings.disposition", "evidence.read", "evidence.restricted"]}]
# NYX_AUTH_PRINCIPALS=[{"principal_id": "ops", "api_key_env": "NYX_AUTH_KEY_OPS", "capabilities": ["findings.disposition"]}]
# NYX_AUTH_KEY_OPS=change-me

# --- API rate limiting (Phase 4). In-memory and per-process. ---
# /health and /ready are exempt: a limiter that blocks health checks is how a dead deployment
# reports itself alive.
# NYX_RATE_LIMIT_ENABLED=true
# NYX_RATE_LIMIT_REQUESTS=120
# NYX_RATE_LIMIT_WINDOW_SECONDS=60

# --- Evidence URL and locator policy (Phase 4). Both default to the safe side. ---
# NYX_EVIDENCE_ALLOW_PRIVATE_URLS=false
# NYX_EVIDENCE_ALLOW_ABSOLUTE_LOCATORS=false

# --- Retention (Phase 4). Purge is destructive and opt-in; legal_hold is never purged. ---
# NYX_RETENTION_PURGE_ENABLED=false
# NYX_RETENTION_EPHEMERAL_DAYS=7
# NYX_RETENTION_STANDARD_DAYS=90
# NYX_RETENTION_EXTENDED_DAYS=365
# NYX_RETENTION_DERIVED_METADATA_DAYS=730

# Optional model critic (Phase 6, c011) and the conversational shell (Phase 7) share these.
# The deterministic critic pack is the core; enabling a model path is an extra, not a default.
NYX_LLM_ENABLED=false
NYX_LLM_PROVIDER=
NYX_LLM_MODEL=

# The model critic is a second switch. It refuses to start unless NYX_LLM_MODEL is set.
# Enabling it sends the redacted event context in the prompt to the configured provider.
# NYX_LLM_CRITIC_ENABLED=false
# Prompt/response pairs can carry personal data even after redaction; storing them in
# critic_runs.llm_io is a separate opt-in and is redacted again at the persistence boundary.
# NYX_LLM_LOG_PROMPTS=false

# Protocol: openai (/v1/chat/completions) or anthropic (/v1/messages).
# NYX_LLM_PROTOCOL=openai
# Default points at the dmr-X gateway, which holds the provider keys -- so NYX needs none.
# NYX_LLM_BASE_URL=http://127.0.0.1:3000
# For direct mode, set the key here. It is sent as the protocol's own auth header.
# A key must NEVER go inside NYX_LLM_BASE_URL: httpx turns https://user:pass@host into a
# Basic auth header on its own, and the adapter refuses such a URL.
# NYX_LLM_API_KEY=
# NYX_LLM_TIMEOUT_SECONDS=300
# NYX_LLM_MAX_RETRIES=0
# NYX_LLM_MAX_TOOL_ROUNDS=8

# Telegram front-end (Phase 7 slice 6.4). Off by default.
# The token comes from @BotFather. Write it into .env yourself -- never paste it into chat.
# The bot answers ONLY private chats from the allowlist below, and rate-limits each user.
# NYX_TELEGRAM_ENABLED=false
# NYX_TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids. Required when enabled: a bot with no allowlist is a bot
# that answers anyone who finds it.
# NYX_TELEGRAM_ALLOWED_USER_IDS=
# NYX_TELEGRAM_ALLOWED_CHAT_IDS=
# NYX_TELEGRAM_REQUIRE_PRIVATE_CHAT=true
# NYX_TELEGRAM_RATE_LIMIT_REQUESTS=20
# NYX_TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
# NYX_TELEGRAM_POLL_TIMEOUT_SECONDS=30

# --- Optional adapters (Phase 5, ADR 0008). Every adapter is OFF by default. -------
# `enabled_adapters` is the deployment filter: an adapter named here is constructed and
# probed; one that is absent is not constructed at all. With the list empty the service
# behaves exactly as it did before Phase 5 -- an adapter is never a prerequisite for core
# NYX, and turning one off never requires cleaning anything up.
# NYX_ENABLED_ADAPTERS=[]

# Git/CI adapter. Enabling it requires a target repository; the GitHub provider also
# requires the NAME of the environment variable holding the token. The token itself is
# never a setting -- it is read from that variable once at client construction, so it
# never enters effective configuration, a log line, or a health detail.
# NYX_GIT_CI_PROVIDER=github            # github | local_git | fixture
# NYX_GIT_CI_API_BASE_URL=https://api.github.com
# NYX_GIT_CI_REPOSITORY=owner/name       # required when the adapter is enabled
# NYX_GIT_CI_TOKEN_ENV=NYX_GITHUB_PAT    # names the variable; the value lives there
# NYX_GIT_CI_TIMEOUT_SECONDS=10
# NYX_GIT_CI_MAX_RUNS_PER_FETCH=10
# Must agree with NYX_EVIDENCE_ALLOW_PRIVATE_URLS: two switches that disagree about which
# targets are fetchable is how an SSRF guard and an adapter end up with different answers.
# NYX_GIT_CI_ALLOW_PRIVATE_TARGETS=false

NYX_AUDIT_VERIFY_ON_STARTUP=true
