# Build context exclusions. Everything here is either regenerated, secret, or irrelevant to the
# image -- copying it in would bloat the context and risk leaking a credential.

# Virtual envs and caches
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
uv/

# Local data and runtime state
data/
tmp/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db

# Secrets and local configuration -- never baked into an image
.env
.env.*
!.env.example
*.pem
*.key

# Agent scratch and local tooling
.agent-prompts/
.opencode/
tool-output/

# VCS and editor
.git/
.gitignore
.github/
.vscode/

# Docs are not needed to run the service
docs/
tests/
scripts/
examples/
schemas/
